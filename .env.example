# ============================================================
# NEXUS BOT — variables d'environnement (modèle SANS valeurs)
# Copie ce fichier en `.env` en local, OU renseigne ces clés
# dans Render → Service → Environment. NE JAMAIS committer les vraies valeurs.
# ============================================================

# --- Discord ---
DISCORD_TOKEN=            # Token du bot (Discord Developer Portal). À RÉGÉNÉRER si exposé.
DISCORD_CHANNEL=          # ID du salon d'IMPORT (dépôt PDF / captures / relevé NSIA)
PANEL_CHANNEL=            # ID du salon PANNEAU de contrôle
REPORT_CHANNEL=           # ID du salon des rapports
GUILD_ID=                 # (optionnel) ID du serveur pour sync rapide des slash-commands

# --- App / API ---
PUBLIC_URL=https://nexus-bot-8iuv.onrender.com   # URL publique du service
# OBLIGATOIRE. 16 caractères minimum, sinon le serveur refuse TOUTES les requêtes
# (avant, une valeur vide ouvrait l'API à tout le monde, et "nexus229" est publique).
# Génère-le : python -c "import secrets;print(secrets.token_urlsafe(32))"
AUTH_TOKEN=
PORT=8080                 # Render fournit $PORT automatiquement
LOG_LEVEL=INFO            # DEBUG pour tracer les appels

# --- Sécurité de l'API ---
RATE_MAX_REQ=120          # requêtes/minute/IP avant 429
AUTH_MAX_FAIL=10          # jetons invalides avant blocage temporaire de l'IP
AUTH_BLOCK_SEC=900        # durée du blocage, en secondes (15 min)

# --- Bitget (proxy signé côté serveur) ---
BITGET_KEY=               # À RÉGÉNÉRER (clés précédentes compromises)
BITGET_SECRET=
BITGET_PASS=              # Passphrase API — surtout PAS un mot de passe perso réutilisé
# Le proxy /bitget n'accepte QUE des chemins de consultation (soldes, prix).
# Le passer à 1 rouvre l'écriture : ordres et retraits redeviennent possibles
# pour quiconque détient AUTH_TOKEN. À laisser vide.
BITGET_ALLOW_WRITE=
BG_CACHE_TTL=60           # secondes de cache sur la vue Bitget (limite les appels API)

# --- Alertes & données ---
ALERT_PCT=5               # seuil d'alerte (en %) de variation du patrimoine sur 24h
MOMO_MAX=5000             # opérations MoMo conservées (~3 ans)
MAX_ATTACH_MB=12          # taille max d'une pièce jointe Discord analysée

# --- OCR (lecture des captures MoMo) ---
OCR_API_KEY=              # Clé OCR.space

# --- Upstash Redis (persistance de l'état) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN= # À RÉGÉNÉRER si exposé
