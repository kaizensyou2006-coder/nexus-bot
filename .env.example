# ============================================================
# NEXUS BOT — variables d'environnement (modèle SANS valeurs)
# Copie ce fichier en `.env` en local, OU renseigne ces clés
# dans Render → Service → Environment. NE JAMAIS committer les vraies valeurs.
# ============================================================

# --- Discord ---
DISCORD_TOKEN=            # Token du bot (Discord Developer Portal). À RÉGÉNÉRER si exposé.
DISCORD_CHANNEL=          # ID du salon d'IMPORT (dépôt PDF / captures / relevé NSIA)
PANEL_CHANNEL=            # ID du salon PANNEAU de contrôle
REPORT_CHANNEL=           # ID du salon des rapports
GUILD_ID=                 # (optionnel) ID du serveur pour sync rapide des slash-commands

# --- App / API ---
PUBLIC_URL=https://nexus-bot-8iuv.onrender.com   # URL publique du service
# OBLIGATOIRE. 16 caractères minimum, sinon le serveur refuse TOUTES les requêtes
# (avant, une valeur vide ouvrait l'API à tout le monde, et "nexus229" est publique).
# Génère-le : python -c "import secrets;print(secrets.token_urlsafe(32))"
AUTH_TOKEN=
PORT=8080                 # Render fournit $PORT automatiquement
LOG_LEVEL=INFO            # DEBUG pour tracer les appels

# --- Sécurité de l'API ---
RATE_MAX_REQ=120          # requêtes/minute/IP avant 429
AUTH_MAX_FAIL=10          # jetons invalides avant blocage temporaire de l'IP
AUTH_BLOCK_SEC=900        # durée du blocage, en secondes (15 min)

# --- Bitget (proxy signé côté serveur) ---
BITGET_KEY=               # À RÉGÉNÉRER (clés précédentes compromises)
BITGET_SECRET=
BITGET_PASS=              # Passphrase API — surtout PAS un mot de passe perso réutilisé
# Le proxy /bitget n'accepte QUE des chemins de consultation (soldes, prix).
# Le passer à 1 rouvre l'écriture : ordres et retraits redeviennent possibles
# pour quiconque détient AUTH_TOKEN. À laisser vide.
BITGET_ALLOW_WRITE=
BG_CACHE_TTL=60           # secondes de cache sur la vue Bitget (limite les appels API)

# --- Alertes & données ---
ALERT_PCT=5               # seuil d'alerte (en %) de variation du patrimoine sur 24h
MOMO_MAX=5000             # opérations MoMo conservées (~3 ans)
MAX_ATTACH_MB=12          # taille max d'une pièce jointe Discord analysée

# --- IA / Agents ---
# Necessaire pour l'Assistant IA + les 5 agents. La cle vit COTE SERVEUR (proxy /ai) :
# l'app ne detient aucune cle. DEUX fournisseurs possibles :
#
# 1) Anthropic / Claude (par defaut)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=        # https://console.anthropic.com
AI_MODEL=                 # vide = claude-opus-5 (claude-sonnet-5 = moins cher)
AI_EFFORT=high            # profondeur : low|medium|high|xhigh|max (Anthropic uniquement)
#
# 2) Compatible OpenAI = PAS besoin de Claude (DeepSeek, OpenRouter, Groq, Ollama local...)
#    Mettre AI_PROVIDER=openai puis renseigner base + cle + modele :
#    - DeepSeek     : AI_BASE_URL=https://api.deepseek.com        AI_MODEL=deepseek-chat
#    - OpenRouter   : AI_BASE_URL=https://openrouter.ai/api/v1    AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free  (GRATUIT)
#    - Groq         : AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile
#    - Ollama local : AI_BASE_URL=http://localhost:11434/v1       AI_MODEL=llama3.1   (aucune cle, hors Render)
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=             # cle du fournisseur (inutile pour Ollama local)
# AI_MODEL=deepseek-chat
# AI_JSON_MODE=1          # 1 = demande une sortie JSON stricte aux agents (recommande)
#
# --- Fournisseur de SECOURS (bascule auto si le principal est saturé : 429 / quota) ---
# Très utile avec un modèle GRATUIT (quota journalier) : si OpenRouter free est épuisé,
# le serveur bascule tout seul sur ce 2e fournisseur. Ex. Groq (gratuit, limites séparées) :
# AI_BASE_URL2=https://api.groq.com/openai/v1
# AI_API_KEY2=gsk_...        # clé Groq (console.groq.com, gratuite)
# AI_MODEL2=llama-3.3-70b-versatile
#
# --- Communs aux deux fournisseurs ---
AI_MAX_TOKENS=8000        # plafond de sortie applique par le proxy
AI_BRIEF_AUTO=1           # 1 = brief d'optimisations poste automatiquement sur Discord
AI_BRIEF_HOUR=8           # heure (WAT) du brief auto
AI_BRIEF_EVERY_DAYS=1     # cadence du brief (1=quotidien, 7=hebdo)

# --- OCR (lecture des captures MoMo) ---
OCR_API_KEY=              # Clé OCR.space

# --- Upstash Redis (persistance de l'état) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN= # À RÉGÉNÉRER si exposé
